# Dropwatch VPS settings. Copy to deploy/.env, fill in, then:
#   chmod 600 deploy/.env
# deploy/.env is gitignored. Lines marked SECRET must never be committed,
# pasted into chat, or put in a ticket. Empty = unset.
# app/config.py validates all of this at boot and refuses to start on a
# bad combination (the container log says exactly what is wrong).

# ---------------------------------------------------------------- site --
# Domain Caddy serves and gets a TLS cert for. DNS A/AAAA must point here
# before the first `up`, or Let's Encrypt will fail (and rate-limit you).
DROPWATCH_DOMAIN=dropwatch.example.com
# Required. Let's Encrypt account email (expiry/problem notices).
ACME_EMAIL=
# https://<DROPWATCH_DOMAIN>. Puts an unsubscribe link in every alert;
# required when billing is on (Stripe redirects back here).
DROPWATCH_PUBLIC_URL=https://dropwatch.example.com
# Optional banner shown above the watch form.
DROPWATCH_NOTICE=
# Image tag compose builds/runs; set to a previous tag to roll back.
DROPWATCH_IMAGE_TAG=latest

# --------------------------------------------------------------- tuning --
# Seconds between dispatch ticks.
DROPWATCH_RUNNER_INTERVAL=5
# Optional JSON list of drops to register at boot (path inside the
# container). Campsite watches don't need it; leave empty.
DROPWATCH_CATALOG=

# Set by compose.yml, not here (listed so nothing is undocumented):
#   DROPWATCH_TRUST_PROXY=1            app sits behind Caddy only
#   DROPWATCH_CLIENT_IP_HEADER=X-Real-IP  Caddy sets it to the real peer
#   DROPWATCH_DB=/data/dropwatch.sqlite3  on the `data` volume
#   DROPWATCH_CAMPGROUNDS=/app/app/campgrounds.json  baked into the image
#   HOST=0.0.0.0  PORT=8787

# -------------------------------------------------------------- billing --
# Set all four or none. Public values: safe to show.
DROPWATCH_PAYMENT_LINK=
DROPWATCH_PORTAL_URL=
# single quotes: compose would otherwise read $5 as a variable
DROPWATCH_PRICE_LABEL='$5/mo'
# SECRET. Stripe webhook signing secret (whsec_...). Without it, payments
# stay off even if the link is set (the app refuses to boot that way).
STRIPE_WEBHOOK_SECRET=

# -------------------------------------------------------------- backups --
# Local copies kept in deploy/backups/ for this many days.
BACKUP_KEEP_DAYS=14
# Off-box copy to an S3-compatible bucket (Backblaze B2 shown). Upload
# runs only when all five of endpoint/region/bucket/key id/key are set.
BACKUP_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
BACKUP_S3_REGION=us-west-004
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=dropwatch/
# SECRET-adjacent: an application key scoped to this one bucket.
BACKUP_S3_ACCESS_KEY_ID=
# SECRET.
BACKUP_S3_SECRET_ACCESS_KEY=
