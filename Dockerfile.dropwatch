# Dropwatch web + dispatch runner. stdlib only -- no pip install.
# (The root Dockerfile is the retired 70mm sentry watcher; this is separate.)
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PORT=8787 \
    DROPWATCH_DB=/data/dropwatch.sqlite3 \
    DROPWATCH_CAMPGROUNDS=/app/deploy/campgrounds.json \
    DROPWATCH_TRUST_PROXY=1

WORKDIR /app
COPY platformd/ platformd/
COPY adapters/ adapters/
COPY deploy/campgrounds.json deploy/campgrounds.json
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin dropwatch \
    && mkdir -p /data && chown dropwatch:dropwatch /data

# subscriptions live here; without a volume every redeploy forgets them
VOLUME ["/data"]
USER dropwatch
EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import os,urllib.request;urllib.request.urlopen('http://127.0.0.1:%s/api/status' % os.environ['PORT'], timeout=4)"]

CMD ["python", "-m", "platformd.serve"]
